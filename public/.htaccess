
<IfModule mod_rewrite.c>
  Options -Multiviews
  RewriteEngine On
  RewriteBase /

  # Acceso directo a archivos reales (imágenes, css, js)
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Redireccionar todo lo demás a index.php
  RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>